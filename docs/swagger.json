                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "authorization_code",
                        "name": "grant_type",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "http://localhost:8088",
                        "name": "redirect_uri",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {}
            }
        },
